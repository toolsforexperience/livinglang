{
	"name": "lsp-web-extension-sample",
	"description": "A language server in a web extension",
	"author": "Microsoft Corporation",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Microsoft/vscode-extension-samples"
	},
	"publisher": "pt",
	"categories": [],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.85.0"
	},
	"activationEvents": [
		"onLanguage:livinglang"
	],
	"browser": "./client/dist/browserClientMain",
	"contributes": {
		"configuration": [
			{
				"order": 22,
				"id": "lsp-web-extension-sample",
				"title": "lsp-web-extension-sample",
				"properties": {
					"lsp-web-extension-sample.trace.server": {
						"type": "string",
						"scope": "window",
						"enum": [
							"off",
							"messages",
							"verbose"
						],
						"default": "verbose",
						"description": "Traces the communication between VS Code and the lsp-web-extension-sample language server."
					}
				}
			}
		],
		"languages": [
			{
				"id": "livinglang",
				"aliases": [
					"LivingLang",
					"livinglang"
				],
				"extensions": [
					".living"
				]
			}
		],
		"semanticTokenTypes": [
			{
				"id": "keyword",
				"superType": "keyword",
				"description": "Keywords like 'experience', 'space', 'sequence'"
			},
			{
				"id": "variable",
				"superType": "variable",
				"description": "Variables like 'lighting', 'sound', 'duration'"
			},
			{
				"id": "function",
				"superType": "function",
				"description": "Keywords like 'on', 'trigger', 'scene', 'atmosphere'"
			}
		],
		"semanticTokenStyleDefaults": {
			"*.keyword": {
				"foreground": "#569CD6",
				"bold": true
			},
			"*.variable": {
				"foreground": "#9CDCFE"
			},
			"*.function": {
				"foreground": "#C586C0"
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"lint": "eslint",
		"test": "ts-mocha -p tsconfig.json test/**/*.ts",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"chrome": "npm run compile && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ./test-data",
		"vsix": "npm run package && mkdir -p dist && cd dist && zip -r ../livinglang.vsix ../package.json ../client/dist/* ../server/dist/*"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.10",
		"@vscode/test-web": "^0.0.51",
		"eslint": "^9.13.0",
		"mocha": "^11.1.0",
		"path-browserify": "^1.0.1",
		"ts-loader": "^9.5.1",
		"ts-mocha": "^10.0.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.16.0",
		"vscode-languageserver-textdocument": "^1.0.12",
		"webpack": "^5.90.1",
		"webpack-cli": "^5.1.4"
	}
}
