{
	"name": "livinglang",
	"description": "An experience language for creating immmersive stories.",
	"author": "Piotr Trzpil",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/livinglang/livinglang"
	},
	"publisher": "PiotrTrzpil",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"livinglang",
		"immersive",
		"storytelling",
		"narrative",
		"experience"
	],
	"engines": {
		"vscode": "^1.85.0",
		"node": ">=20.11.0"
	},
	"activationEvents": [
		"onLanguage:livinglang"
	],
	"browser": "./client/dist/browserClientMain",
	"contributes": {
		"configuration": [
			{
				"order": 22,
				"id": "lsp-web-extension-sample",
				"title": "lsp-web-extension-sample",
				"properties": {
					"lsp-web-extension-sample.trace.server": {
						"type": "string",
						"scope": "window",
						"enum": [
							"off",
							"messages",
							"verbose"
						],
						"default": "verbose",
						"description": "Traces the communication between VS Code and the lsp-web-extension-sample language server."
					}
				}
			}
		],
		"languages": [
			{
				"id": "livinglang",
				"aliases": [
					"LivingLang",
					"livinglang"
				],
				"extensions": [
					".living"
				]
			}
		],
		"semanticTokenTypes": [
			{
				"id": "name",
				"superType": "type",
				"description": "Style for entity names"
			}
		],
		"semanticTokenScopes": [
			{
				"scopes": {
					"string": ["string.quoted.double", "string.quoted.triple"],
					"keyword": ["keyword.control"],
					"property": ["variable.other.property"],
					"value": ["constant.other"],
					"name": ["entity.name"]
				}
			}
		],
		"semanticTokenStyleDefaults": {
			"*.keyword": {
				"foreground": "#569CD6",
				"bold": true
			},
			"*.function": {
				"foreground": "#C586C0"
			},
			"*.string": {
				"foreground": "#CE9178"
			},
			"*.property": {
				"foreground": "#9CDCFE"
			},
			"*.value": {
				"foreground": "#DCDCAA"
			},
			"name": {
				"foreground": "#4EC9B0",
				"bold": true
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"lint": "eslint",
		"test": "ts-mocha -p tsconfig.json test/**/*.ts",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"chrome": "npm run compile && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ./test-data",
		"vsix": "npm run package && vsce package"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@vscode/test-web": "^0.0.51",
		"@vscode/vsce": "^3.2.2",
		"eslint": "^9.13.0",
		"mocha": "^10.2.0",
		"path-browserify": "^1.0.1",
		"ts-loader": "^9.5.1",
		"ts-mocha": "^10.0.0",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.16.0",
		"vscode-languageserver-textdocument": "^1.0.12",
		"webpack": "^5.90.1",
		"webpack-cli": "^5.1.4"
	}
}
