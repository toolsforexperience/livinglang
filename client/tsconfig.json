{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"lib": ["ES2020", "WebWorker"],
		"outDir": "dist",
		"rootDir": "../",
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*",
		"../shared/**/*"
	],
	"exclude": [
		"node_modules",
		".vscode-test-web"
	]
}
