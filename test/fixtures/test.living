experience TestHighlighting {
  space MainArea {
    atmosphere {
      lighting: ambient_soft
      sound: nature_sounds
      temperature: warm
    }

    zones {
      welcome_zone {
        lighting: bright
        activity: greeting
      }
    }
  }

  actor Guide {
    name: 'Test Guide'
    description: 'A test character'
    archetypes: [guide, mentor, helper]
    
    behavior {
      style: welcoming
      presence: gentle
    }
  }

  scene WelcomeScene {
    atmosphere {
      lighting: bright
      sound: welcome_music
      duration: 5.minutes
    }

    actions {
      Guide.greet()
      Guide.explain_space()
    }
  }

  sequence welcome_sequence {
    scene WelcomeScene {
      duration: 10.minutes
    }
  }
} 
