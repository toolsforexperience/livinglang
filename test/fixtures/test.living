experience TestHighlighting {
  space MainArea {
    atmosphere {
      lighting = ambient("soft")
      sound = background("nature")
      duration = 5.minutes
    }

    on audience.enter {
      trigger welcome_sequence
    }
  }

  sequence welcome_sequence {
    scene {
      lighting.fadeTo("bright")
      sound.play("welcome_music")
    }
  }
} 
