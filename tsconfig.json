{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "lib": ["ES2020"],
        "outDir": "out",
        "rootDir": ".",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true
    },
    "include": [
        "client/src/**/*",
        "server/src/**/*",
        "test/**/*"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test-web"
    ]
} 